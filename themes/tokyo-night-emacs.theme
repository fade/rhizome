;;;; tokyo-night-emacs.theme: rhizome colour theme, format 1
;;;;
;;;; Origin: the Emacs theme tokyo-night (night variant) from
;;;;   tokyo-night-emacs, converted to rhizome roles. rhizome's default
;;;;   theme, tokyo-night, is a separate file and keeps its own colours.
;;;; Authors: Emacs port by Bozhidar Batsov, Copyright (C) 2026
;;;;   Bozhidar Batsov. Tokyo Night palette by Enkia
;;;;   (https://github.com/tokyo-night/tokyo-night-vscode-theme, MIT,
;;;;   notice below), also carried by folke's tokyonight.nvim
;;;;   (https://github.com/folke/tokyonight.nvim, Apache-2.0).
;;;; Licence: GPL-3.0-or-later, the licence of the Emacs theme it derives
;;;;   from, with Enkia's MIT notice kept for the palette. rhizome is
;;;;   AGPL-3.0-or-later; section 13 of the GPLv3 and section 13 of the
;;;;   AGPLv3 permit combining the two.
;;;;
;;;; Generated by tools/theme-convert from the Emacs theme tokyo-night
;;;;   https://github.com/bbatsov/tokyo-night-emacs, version v1.1.0, resolved in Emacs 31.1.90
;;;;   for a 24-bit graphic display, background dark.
;;;; Roles with no face in the Emacs theme:
;;;;   :surface-border follows :hairline
;;;;   :notice takes the default theme's #ff5fd7
;;;;   :shadow takes the default theme's #1e1e24
;;;; Contrast (WCAG 2), pairs below 7:1 kept as the source renders them:
;;;;   foreground on background     #c0caf5 on #1a1b26  10.6:1
;;;;   bar text on bar              #c0caf5 on #1a1b26  10.6:1
;;;;   entry on launcher            #a9b1d6 on #0c0e14   9.1:1
;;;;   selected entry on selection  #c0caf5 on #292e42   8.3:1
;;;;   match on launcher            #7aa2f7 on #0c0e14   7.7:1
;;;;   match on selection           #7aa2f7 on #292e42   5.3:1  below 7:1
;;;;   focused border on bar        #73daca on #1a1b26  10.3:1
;;;;   unfocused border on bar      #414868 on #1a1b26   1.9:1  BELOW 4.5:1
;;;; Hue-only state pairs: none; each of 10 pairs carries a non-hue cue
;;;;
;;;; The MIT License (MIT)
;;;;
;;;; Copyright (c) 2018-present Enkia
;;;;
;;;; Permission is hereby granted, free of charge, to any person obtaining
;;;; a copy of this software and associated documentation files (the
;;;; "Software"), to deal in the Software without restriction, including
;;;; without limitation the rights to use, copy, modify, merge, publish,
;;;; distribute, sublicense, and/or sell copies of the Software, and to
;;;; permit persons to whom the Software is furnished to do so, subject to
;;;; the following conditions:
;;;;
;;;; The above copyright notice and this permission notice shall be
;;;; included in all copies or substantial portions of the Software.
;;;;
;;;; THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
;;;; EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
;;;; MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
;;;; NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
;;;; LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
;;;; OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
;;;; WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

(:format 1
 :name "tokyo-night-emacs"
 :roles (:background "#1a1b26"         ; default
         :foreground "#c0caf5"         ; default
         :accent "#73daca"             ; link
         :muted "#565f89"              ; shadow
         :focus :accent                ; follows :accent, as in the default theme
         :unfocus "#414868"            ; vertical-border
         :hairline "#414868"           ; vertical-border
         :surface "#0c0e14"            ; tab-bar
         :surface-foreground "#a9b1d6" ; tab-bar
         :surface-border :hairline     ; no face: follows :hairline
         :selection "#292e42"          ; vertico-current
         :selection-foreground "#c0caf5" ; vertico-current
         :match "#7aa2f7"              ; completions-common-part
         :error "#db4b4b"              ; error
         :warning "#e0af68"            ; warning
         :notice "#ff5fd7"             ; no face: default theme
         :shadow "#1e1e24"             ; no face: default theme
         )
 :elements (:launcher-prompt "#7dcfff"    ; minibuffer-prompt
            :prompt-title "#7dcfff"       ; minibuffer-prompt
            :launcher-cursor "#c0caf5"    ; cursor
            ))
