;;;; modus-vivendi-tritanopia.theme: rhizome colour theme, format 1
;;;;
;;;; Origin: the Emacs theme modus-vivendi-tritanopia, converted to rhizome roles.
;;;; Authors: Protesilaos Stavrou.
;;;;   Copyright (C) 2019-2026 Free Software Foundation, Inc.
;;;; Licence: GPL-3.0-or-later, the licence of the Emacs theme it derives
;;;;   from. rhizome is AGPL-3.0-or-later; section 13 of the GPLv3 and
;;;;   section 13 of the AGPLv3 permit combining the two.
;;;;
;;;; Generated by tools/theme-convert from the Emacs theme modus-vivendi-tritanopia
;;;;   https://github.com/protesilaos/modus-themes, version 5.2.0, resolved in Emacs 31.1.90
;;;;   for a 24-bit graphic display, background dark.
;;;; Roles with no face in the Emacs theme:
;;;;   :surface-border follows :hairline
;;;;   :notice takes the default theme's #ff5fd7
;;;;   :shadow takes the default theme's #1e1e24
;;;; Contrast (WCAG 2), pairs below 7:1 kept as the source renders them:
;;;;   foreground on background     #ffffff on #000000  21.0:1
;;;;   bar text on bar              #ffffff on #000000  21.0:1
;;;;   entry on launcher            #ffffff on #313131  13.0:1
;;;;   selected entry on selection  #ffffff on #004253  11.0:1
;;;;   match on launcher            #00d3d0 on #313131   7.0:1  below 7:1
;;;;   match on selection           #00d3d0 on #004253   5.9:1  below 7:1
;;;;   focused border on bar        #00d3d0 on #000000  11.2:1
;;;;   unfocused border on bar      #646464 on #000000   3.5:1  BELOW 4.5:1
;;;; Hue-only state pairs: none; each of 10 pairs carries a non-hue cue

(:format 1
 :name "modus-vivendi-tritanopia"
 :roles (:background "#000000"         ; default
         :foreground "#ffffff"         ; default
         :accent "#00d3d0"             ; link
         :muted "#989898"              ; shadow
         :focus :accent                ; follows :accent, as in the default theme
         :unfocus "#646464"            ; vertical-border
         :hairline "#646464"           ; vertical-border
         :surface "#313131"            ; tab-bar
         :surface-foreground "#ffffff" ; tab-bar
         :surface-border :hairline     ; no face: follows :hairline
         :selection "#004253"          ; vertico-current
         :selection-foreground "#ffffff" ; vertico-current
         :match "#00d3d0"              ; completions-common-part
         :error "#ff6740"              ; error
         :warning "#feacd0"            ; warning
         :notice "#ff5fd7"             ; no face: default theme
         :shadow "#1e1e24"             ; no face: default theme
         )
 :elements (:launcher-prompt "#6ae4b9"    ; minibuffer-prompt
            :prompt-title "#6ae4b9"       ; minibuffer-prompt
            :launcher-cursor "#ff5f5f"    ; cursor
            ))
