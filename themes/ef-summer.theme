;;;; ef-summer.theme: rhizome colour theme, format 1
;;;;
;;;; Origin: the Emacs theme ef-summer, converted to rhizome roles.
;;;; Authors: Protesilaos Stavrou.
;;;;   Copyright (C) 2022-2026 Free Software Foundation, Inc.
;;;; Licence: GPL-3.0-or-later, the licence of the Emacs theme it derives
;;;;   from. rhizome is AGPL-3.0-or-later; section 13 of the GPLv3 and
;;;;   section 13 of the AGPLv3 permit combining the two.
;;;;
;;;; Generated by tools/theme-convert from the Emacs theme ef-summer
;;;;   https://github.com/protesilaos/ef-themes, version 2.2.1, resolved in Emacs 31.1.90
;;;;   for a 24-bit graphic display, background light.
;;;; Roles with no face in the Emacs theme:
;;;;   :surface-border follows :hairline
;;;;   :shadow takes the default theme's #1e1e24
;;;; Contrast (WCAG 2), pairs below 7:1 kept as the source renders them:
;;;;   foreground on background     #4f4073 on #fff2f3   8.3:1
;;;;   bar text on bar              #4f4073 on #fff2f3   8.3:1
;;;;   entry on launcher            #4f4073 on #efd3e4   6.5:1  below 7:1
;;;;   selected entry on selection  #4f4073 on #f4cfef   6.5:1  below 7:1
;;;;   match on launcher            #8e44f3 on #efd3e4   3.5:1  BELOW 4.5:1
;;;;   match on selection           #8e44f3 on #f4cfef   3.5:1  BELOW 4.5:1
;;;;   focused border on bar        #375ce6 on #fff2f3   5.0:1  below 7:1
;;;;   unfocused border on bar      #c6bbc6 on #fff2f3   1.7:1  BELOW 4.5:1
;;;; Hue-only state pairs: none; each of 10 pairs carries a non-hue cue

(:format 1
 :name "ef-summer"
 :roles (:background "#fff2f3"         ; default
         :foreground "#4f4073"         ; default
         :accent "#375ce6"             ; link
         :muted "#786e74"              ; shadow
         :focus :accent                ; follows :accent, as in the default theme
         :unfocus "#c6bbc6"            ; vertical-border
         :hairline "#c6bbc6"           ; vertical-border
         :surface "#efd3e4"            ; tab-bar
         :surface-foreground "#4f4073" ; tab-bar
         :surface-border :hairline     ; no face: follows :hairline
         :selection "#f4cfef"          ; vertico-current
         :selection-foreground "#4f4073" ; vertico-current
         :match "#8e44f3"              ; completions-common-part
         :error "#e00033"              ; error
         :shadow "#1e1e24"             ; no face: default theme
         )
 :elements (:launcher-prompt "#cb1aaa"    ; minibuffer-prompt
            :prompt-title "#cb1aaa"       ; minibuffer-prompt
            :launcher-cursor "#cf0090"    ; cursor
            ))
