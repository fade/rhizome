;;;; deepsky-moonunit.theme: rhizome colour theme, format 1
;;;;
;;;; Origin: the Emacs theme deepsky-moonunit, as it renders with its
;;;;   author's theme settings, converted to rhizome roles.
;;;; Authors: Brian O'Reilly (deepsky-moonunit), built on the Modus
;;;;   themes by Protesilaos Stavrou.
;;;;   Copyright (C) 2020-2026 Brian O'Reilly
;;;;   Copyright (C) 2019-2026 Free Software Foundation, Inc.
;;;; Licence: GPL-3.0-or-later, the licence of the Emacs theme it derives
;;;;   from. rhizome is AGPL-3.0-or-later; section 13 of the GPLv3 and
;;;;   section 13 of the AGPLv3 permit combining the two.
;;;;
;;;; Generated by tools/theme-convert from the Emacs theme deepsky-moonunit
;;;;   https://github.com/fade/deepsky-themes-moonunit, version 2d4ed8c, resolved in Emacs 31.1.90
;;;;   for a 24-bit graphic display, background dark.
;;;; Author's settings applied: modus-themes-mixed-fonts t, mode-line
;;;;   :box nil, cursor colour "yellow".
;;;; Corrections to the source, applied as if fixed there:
;;;;   1. the stray (set-face-foreground 'cursor "navy") in the palette is ignored (holds)
;;;;   2. dblue, written " #1874cd", is read as #1874cd (applied)
;;;;   3. magit-diff-added-highlight :forground is read as :foreground (holds)
;;;;   4. the second, dead isearch spec stays ignored (holds)
;;;; Roles with no face in the Emacs theme:
;;;;   :surface-border follows :hairline
;;;;   :shadow takes the default theme's #1e1e24
;;;; Contrast (WCAG 2), pairs below 7:1 kept as the source renders them:
;;;;   foreground on background     #ffffff on #000000  21.0:1
;;;;   bar text on bar              #ffffff on #000000  21.0:1
;;;;   entry on launcher            #ffffff on #2c2c2c  14.0:1
;;;;   selected entry on selection  #ffffff on #10387c  11.2:1
;;;;   match on launcher            #00bcff on #2c2c2c   6.4:1  below 7:1
;;;;   match on selection           #00bcff on #10387c   5.1:1  below 7:1
;;;;   focused border on bar        #00bcff on #000000   9.6:1
;;;;   unfocused border on bar      #646464 on #000000   3.5:1  BELOW 4.5:1
;;;; Hue-only state pairs: none; each of 10 pairs carries a non-hue cue

(:format 1
 :name "deepsky-moonunit"
 :roles (:background "#000000"         ; default
         :foreground "#ffffff"         ; default
         :accent "#00bcff"             ; link
         :muted "#a8a8a8"              ; shadow
         :focus :accent                ; follows :accent, as in the default theme
         :unfocus "#646464"            ; vertical-border
         :hairline "#646464"           ; vertical-border
         :surface "#2c2c2c"            ; tab-bar
         :surface-foreground "#ffffff" ; tab-bar
         :surface-border :hairline     ; no face: follows :hairline
         :selection "#10387c"          ; vertico-current
         :selection-foreground "#ffffff" ; vertico-current
         :match "#00bcff"              ; completions-common-part
         :error "#ff8059"              ; error
         :shadow "#1e1e24"             ; no face: default theme
         )
 :elements (:launcher-prompt "#6ae4b9"    ; minibuffer-prompt
            :prompt-title "#6ae4b9"       ; minibuffer-prompt
            :launcher-cursor "#ffff00"    ; cursor
            ))
