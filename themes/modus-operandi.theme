;;;; modus-operandi.theme: rhizome colour theme, format 1
;;;;
;;;; Origin: the Emacs theme modus-operandi, converted to rhizome roles.
;;;; Authors: Protesilaos Stavrou.
;;;;   Copyright (C) 2019-2026 Free Software Foundation, Inc.
;;;; Licence: GPL-3.0-or-later, the licence of the Emacs theme it derives
;;;;   from. rhizome is AGPL-3.0-or-later; section 13 of the GPLv3 and
;;;;   section 13 of the AGPLv3 permit combining the two.
;;;;
;;;; Generated by tools/theme-convert from the Emacs theme modus-operandi
;;;;   https://github.com/protesilaos/modus-themes, version 5.2.0-52-ge0f42f27, resolved in Emacs 31.1.90
;;;;   for a 24-bit graphic display, background light.
;;;; Roles with no face in the Emacs theme:
;;;;   :surface-border follows :hairline
;;;;   :shadow takes the default theme's #1e1e24
;;;; Contrast (WCAG 2), pairs below 7:1 kept as the source renders them:
;;;;   foreground on background     #000000 on #ffffff  21.0:1
;;;;   bar text on bar              #000000 on #ffffff  21.0:1
;;;;   entry on launcher            #000000 on #dfdfdf  15.8:1
;;;;   selected entry on selection  #000000 on #c0deff  15.1:1
;;;;   match on launcher            #0031a9 on #dfdfdf   7.8:1
;;;;   match on selection           #0031a9 on #c0deff   7.5:1
;;;;   focused border on bar        #3548cf on #ffffff   7.0:1
;;;;   unfocused border on bar      #9f9f9f on #ffffff   2.6:1  BELOW 4.5:1
;;;; Hue-only state pairs: none; each of 10 pairs carries a non-hue cue

(:format 1
 :name "modus-operandi"
 :roles (:background "#ffffff"         ; default
         :foreground "#000000"         ; default
         :accent "#3548cf"             ; link
         :muted "#595959"              ; shadow
         :focus :accent                ; follows :accent, as in the default theme
         :unfocus "#9f9f9f"            ; vertical-border
         :hairline "#9f9f9f"           ; vertical-border
         :surface "#dfdfdf"            ; tab-bar
         :surface-foreground "#000000" ; tab-bar
         :surface-border :hairline     ; no face: follows :hairline
         :selection "#c0deff"          ; vertico-current
         :selection-foreground "#000000" ; vertico-current
         :match "#0031a9"              ; completions-common-part
         :error "#a60000"              ; error
         :shadow "#1e1e24"             ; no face: default theme
         )
 :elements (:launcher-prompt "#005f5f"    ; minibuffer-prompt
            :prompt-title "#005f5f"       ; minibuffer-prompt
            :launcher-cursor "#000000"    ; cursor
            ))
