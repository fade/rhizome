;;;; kusanagi.theme: rhizome colour theme, format 1
;;;;
;;;; Origin: the Emacs theme kusanagi, converted to rhizome roles.
;;;; Authors: Rahul Martim Juliato, built on the Modus themes by
;;;;   Protesilaos Stavrou (Copyright (C) 2019-2026 Free Software
;;;;   Foundation, Inc.).
;;;; Licence: GPL-3.0-or-later, the licence of the Emacs theme it derives
;;;;   from. rhizome is AGPL-3.0-or-later; section 13 of the GPLv3 and
;;;;   section 13 of the AGPLv3 permit combining the two.
;;;;
;;;; Generated by tools/theme-convert from the Emacs theme kusanagi
;;;;   https://github.com/LionyxML/kusanagi-theme, version 0.1.1, resolved in Emacs 31.1.90
;;;;   for a 24-bit graphic display, background dark.
;;;; Roles with no face in the Emacs theme:
;;;;   :surface-border follows :hairline
;;;;   :shadow takes the default theme's #1e1e24
;;;; Contrast (WCAG 2), pairs below 7:1 kept as the source renders them:
;;;;   foreground on background     #68b8cc on #050810   8.9:1
;;;;   bar text on bar              #68b8cc on #050810   8.9:1
;;;;   entry on launcher            #68b8cc on #1e1e1e   7.4:1
;;;;   selected entry on selection  #8ecede on #0a1a2a  10.1:1
;;;;   match on launcher            #00e5ff on #1e1e1e  10.8:1
;;;;   match on selection           #00e5ff on #0a1a2a  11.4:1
;;;;   focused border on bar        #00e5ff on #050810  13.0:1
;;;;   unfocused border on bar      #646464 on #050810   3.4:1  BELOW 4.5:1
;;;; Hue-only state pairs: none; each of 10 pairs carries a non-hue cue

(:format 1
 :name "kusanagi"
 :roles (:background "#050810"         ; default
         :foreground "#68b8cc"         ; default
         :accent "#00e5ff"             ; link
         :muted "#989898"              ; shadow
         :focus :accent                ; follows :accent, as in the default theme
         :unfocus "#646464"            ; vertical-border
         :hairline "#646464"           ; vertical-border
         :surface "#1e1e1e"            ; header-line
         :surface-foreground "#68b8cc" ; header-line
         :surface-border :hairline     ; no face: follows :hairline
         :selection "#0a1a2a"          ; vertico-current
         :selection-foreground "#8ecede" ; vertico-current
         :match "#00e5ff"              ; completions-common-part
         :error "#ff0044"              ; error
         :shadow "#1e1e24"             ; no face: default theme
         )
 :elements (:launcher-prompt "#cc55ff"    ; minibuffer-prompt
            :prompt-title "#cc55ff"       ; minibuffer-prompt
            :launcher-cursor "#00e5ff"    ; cursor
            ))
