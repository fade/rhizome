#!/bin/bash
# rhizome-cmd — send a command to the running rhizome WM via its
# IPC socket and print the reply.
#
#   rhizome-cmd switch-workspace 3
#   rhizome-cmd current-workspace
#   rhizome-cmd "(* 2 21)"

# The WM listens on $XDG_RUNTIME_DIR/rhizome.sock, or on
# /tmp/rhizome-UID.sock when XDG_RUNTIME_DIR is unset or empty.
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  SOCK="$XDG_RUNTIME_DIR/rhizome.sock"
else
  SOCK="/tmp/rhizome-$(id -u).sock"
fi

if [[ ! -S "$SOCK" ]]; then
  echo "rhizome-cmd: no socket at $SOCK (is rhizome running?)" >&2
  exit 1
fi

exec python3 - "$SOCK" "$*" <<'EOF'
import socket, sys
path, line = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10)
try:
    s.connect(path)
    s.sendall((line + "\n").encode())
    data = b""
    while b"\n" not in data:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
    # A reply is one line: a newline inside it arrives as \n and a
    # backslash as \\.
    reply = data.split(b"\n", 1)[0].decode(errors="replace")
    out, i = [], 0
    while i < len(reply):
        if reply[i] == "\\" and reply[i + 1:i + 2] in ("n", "\\"):
            out.append("\n" if reply[i + 1] == "n" else "\\")
            i += 2
        else:
            out.append(reply[i])
            i += 1
    sys.stdout.write("".join(out).strip() + "\n")
except (ConnectionRefusedError, FileNotFoundError):
    print("rhizome-cmd: cannot connect to rhizome", file=sys.stderr)
    sys.exit(1)
EOF
